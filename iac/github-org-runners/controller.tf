locals {
  # Helm installs a chart's crds/ directory on first install only and never
  # upgrades it. The controller image DOES upgrade with the chart, so bumping
  # arc_version without also applying the new CRDs leaves the controller
  # writing status fields the old CRD schema rejects (seen with controller
  # 0.15.1 on 2024-12 CRDs: endless "status.currentReplicas: Required value"
  # reconcile errors, EphemeralRunnerSet status never persisted, every
  # EphemeralRunner stuck phase=Pending).
  #
  # The CRDs are therefore vendored in crds/ (copied verbatim from the chart of
  # the same version) and applied here on every arc_version change. To bump:
  #   1. update arc_version in main.tf
  #   2. helm pull oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller \
  #        --version <new arc_version> --untar --untardir /tmp/arc
  #      cp /tmp/arc/gha-runner-scale-set-controller/crds/*.yaml crds/
  #   3. tofu apply (this resource re-runs because triggers_replace changed;
  #      server-side apply over the previously client-side-applied CRDs is
  #      idempotent — plain `kubectl apply` cannot be used here because the
  #      0.15.x CRDs exceed the 256KiB last-applied-configuration annotation
  #      limit)
  arc_crds_dir = "${path.module}/crds"
}

resource "terraform_data" "actions_runner_controller_crds" {
  triggers_replace = [local.arc_version, local.arc_crds_dir]

  provisioner "local-exec" {
    # ../cluster.yml is generated by iac/cluster-config-write.sh both locally
    # and by the deploy pipeline's setup-cluster action.
    command = "KUBECONFIG=../cluster.yml kubectl apply --server-side --force-conflicts -f '${local.arc_crds_dir}/'"
  }
}

resource "helm_release" "actions_runner_controller" {
  name = "scale-set-controller"

  depends_on = [terraform_data.actions_runner_controller_crds]

  repository = "oci://ghcr.io/actions/actions-runner-controller-charts"
  chart      = "gha-runner-scale-set-controller"
  version    = local.arc_version

  namespace = kubernetes_namespace.github_org_runners.metadata[0].name

  timeout = 300

  set = [
    {
      name  = "flags.logLevel"
      value = "info"
    },
  ]
}
